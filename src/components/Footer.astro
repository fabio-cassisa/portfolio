---
import { info } from '@data/info';
---

<footer class="mt-20 pt-8 border-t border-[var(--color-border)]">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[var(--color-text-muted)]">
    <div class="flex items-center gap-4">
      {
        Object.entries(info.socialMedia).map(([name, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)] transition-colors"
          >
            {name}
          </a>
        ))
      }
      <a href="/resume" class="hover:text-[var(--color-accent)] transition-colors">resume</a>
    </div>
    <span class="inline-flex items-center gap-2">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
      <span id="footer-clock" style="font-variant-numeric:tabular-nums">--:--:--</span>
      <span id="footer-tz" class="text-[var(--color-text-muted)]">CET</span>
    </span>
    <p>
      <span class="text-[var(--color-accent)]">{info.name.toLowerCase()}</span> · 2024–{new Date().getFullYear()}
    </p>
  </div>
</footer>

<script>
  // Malmö time, not the visitor's — the label follows CET/CEST
  const clockFmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Stockholm',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
    timeZoneName: 'short',
  });
  function tickClock() {
    const el = document.getElementById('footer-clock');
    if (!el) return;
    const parts = clockFmt.formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    el.textContent = `${get('hour')}:${get('minute')}:${get('second')}`;
    const tz = document.getElementById('footer-tz');
    if (tz) tz.textContent = get('timeZoneName');
  }
  tickClock();
  setInterval(tickClock, 1000);
  document.addEventListener('astro:page-load', tickClock);
</script>
